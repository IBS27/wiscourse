# Copy to .env.local and fill in. `bunx convex dev` manages the CONVEX_* values.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Convex deployment environment variables (set with `bunx convex env set` or
# in the Convex dashboard, NOT in this file):
#   CLERK_FRONTEND_API_URL   - from the Clerk dashboard's Convex integration
#   CANVAS_ENCRYPTION_KEY    - generate with: openssl rand -base64 32
